# you.md ChatGPT app — server configuration

# Port for the remote MCP endpoint (default 8787)
PORT=8787

# Path the MCP endpoint is served on (default /mcp)
YOUMD_MCP_ENDPOINT=/mcp

# Bearer tokens, comma-separated "token:user_id" pairs.
# Required in production — the server refuses to start unauthenticated there.
YOUMD_API_TOKENS=replace-me:user_1

# Postgres connection string. Unset means the in-memory store, which loses
# every profile on restart. Requires `npm install pg` in the deployment.
# DATABASE_URL=postgres://user:pass@host:5432/youmd

# Telemetry sink: "console" writes JSON lines to stderr. Unset means no
# telemetry. Profile text is never included either way.
YOUMD_TELEMETRY=console
